{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "plugins": [{ "name": "workflow" }]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "workflows/**/*.ts", "nitro.config.ts"],
  "exclude": ["node_modules", ".output", ".nitro"]
}
